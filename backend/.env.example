# Google Gemini API Key (From https://aistudio.google.com/ - Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier (Gemini 2.0 Flash is recommended for high speed & search grounding)
GEMINI_MODEL=gemini-2.0-flash

# Pinecone Vector Database (From https://www.pinecone.io/ - Free Serverless Starter)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=catty-memory

# Server Settings
HOST=0.0.0.0
PORT=8005
