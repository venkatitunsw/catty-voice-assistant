# Google Gemini API Key (Get your free key from https://aistudio.google.com/)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Pinecone Serverless Vector Database (Get from https://www.pinecone.io/)
EXPO_PUBLIC_PINECONE_API_KEY=your_pinecone_api_key_here
EXPO_PUBLIC_PINECONE_INDEX_NAME=catty-memory
EXPO_PUBLIC_PINECONE_INDEX_HOST=https://your-index-host.pinecone.io

# Optional Local Backend Fallback URL
EXPO_PUBLIC_BACKEND_URL=http://localhost:8005
